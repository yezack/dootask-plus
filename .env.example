TIMEZONE=PRC

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_SCHEME=auto
APP_URL=http://localhost

APP_PORT=2222

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# -----------------------------------------------------------------------------
# UniAuthSync OIDC 统一登录
# -----------------------------------------------------------------------------
# 模式：
#   disabled  = 关闭统一登录，只保留 DooTask 本地登录
#   available = 同时显示统一登录和本地登录（推荐上线前测试）
#   required  = 强制统一登录，禁止本地密码登录
UNIAUTH_MODE=disabled

# 下面两个是旧版兼容配置。只有 UNIAUTH_MODE 留空时才会生效；新部署请只配置 UNIAUTH_MODE。
UNIAUTH_ENABLED=false
UNIAUTH_ALLOW_LOCAL_LOGIN=true

# 只有使用 http:// 的内网地址时才改为 true。HTTPS（包括自签名证书）不需要打开此项。
UNIAUTH_ALLOW_INSECURE_HTTP=false

# OIDC 状态、票据和 JWKS 缓存使用的 Laravel cache store。Docker 部署保持 redis。
UNIAUTH_CACHE_STORE=redis

# UniAuthSync 的 OIDC issuer，必须与 UniAuthSync 的 issuer 配置完全一致（含协议和端口）。
UNIAUTH_ISSUER=https://oauth.example.com

# UniAuthSync 中为 DooTask 创建的客户端凭据。OIDC 与 SCIM 可共用同一个客户端。
# 不要把真实 secret 提交到 Git。
UNIAUTH_CLIENT_ID=
UNIAUTH_CLIENT_SECRET=

# UniAuthSync 客户端允许的回调地址。必须与此处完全一致，并在 UniAuthSync 客户端中登记。
UNIAUTH_REDIRECT_URI=https://dootask.example.com/api/uniauth/callback

# OIDC scope。UniAuthSync 当前需要 openid、profile、email。
UNIAUTH_SCOPES="openid profile email"

# OIDC 网络请求超时（秒）及缓存时长，一般保持默认值。
UNIAUTH_HTTP_TIMEOUT=30
UNIAUTH_JWKS_CACHE_SECONDS=3600
UNIAUTH_STATE_TTL_SECONDS=600
UNIAUTH_TICKET_TTL_SECONDS=60

# 是否校验 UniAuthSync HTTPS 证书。
# 公网或跨网络部署必须为 true；可信隔离内网使用自签名证书时可改为 false。
UNIAUTH_VERIFY_TLS=true

# -----------------------------------------------------------------------------
# UniAuthSync SCIM 用户、组织和分组同步
# -----------------------------------------------------------------------------
# UniAuthSync 服务根地址，例如 https://oauth.example.com，不要填写 /scim/v2 结尾。
SCIM_SERVER_URL=https://oauth.example.com

# 可选的 SET/OIDC issuer。通常留空，留空时使用 SCIM_SERVER_URL；只有两者不同才填写。
SCIM_ISSUER=

# UniAuthSync 中为 DooTask 创建的 SCIM 客户端凭据；共用客户端时与上面的 OIDC 值相同。
SCIM_CLIENT_ID=
SCIM_CLIENT_SECRET=

# SCIM HTTPS 证书校验。隔离内网自签名证书可设为 false，公网部署保持 true。
SCIM_VERIFY_TLS=true

# 定时同步间隔和同步锁时长（秒）。保持默认即可。
SCIM_POLL_INTERVAL=60
SCIM_LOCK_SECONDS=3600

# UniAuthSync 客户端的 scim_event_secret。用于校验 SET webhook 的 HMAC 签名，必须填写真实值。
# 同时在 UniAuthSync 客户端中将 scim_event_uri 配置为 https://dootask.example.com/api/scim/webhook。
SCIM_WEBHOOK_SECRET=

# 新建 SCIM 用户的本地随机密码前缀，可留空。SCIM 创建用户不会强制 changepass；统一登录由 OIDC 完成。
SCIM_DEFAULT_PASSWORD_PREFIX=

# 是否同步部门，以及没有任何可映射部门时是否拒绝创建/更新用户。
SCIM_SYNC_DEPARTMENT=true
SCIM_REQUIRE_DEPARTMENT=true

# 顶层 Organization 在 DooTask 中生成根部门时使用的负责人邮箱。
# 必须是 UniAuthSync 中已同步、启用且拥有 DooTask 管理员权限的用户；不做顶层组织同步时留空。
SCIM_ROOT_DEPARTMENT_OWNER_EMAIL=

# 是否让 UniAuthSync 的直接 Group 成员关系权威替换 DooTask 用户部门关系。
# false 保留 DooTask 中其他部门关系；true 会按 SCIM 结果替换（负责人/协管所在部门会保留）。
SCIM_REPLACE_DEPARTMENTS=false

# SCIM active=true 是否恢复 DooTask 中已人工离职的用户。默认 false，避免覆盖本地停用决定。
SCIM_REACTIVATE_USERS=false
