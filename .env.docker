TIMEZONE=PRC

APP_NAME=DooTask
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_SCHEME=auto
APP_URL=http://localhost

APP_ID=
APP_IPPR=
APP_PORT=2222
APP_SSL_PORT=
APP_DEV_PORT=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=dootask
DB_USERNAME=dootask
DB_PASSWORD=123456

DB_ROOT_PASSWORD=
DB_PREFIX=pre_

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# -----------------------------------------------------------------------------
# UniAuthSync OIDC 统一登录
# -----------------------------------------------------------------------------
# disabled：关闭统一登录；available：统一登录和本地登录并存；required：强制统一登录。
UNIAUTH_MODE=disabled

# 旧版兼容配置，仅在 UNIAUTH_MODE 留空时生效。新部署无需修改。
UNIAUTH_ENABLED=false
UNIAUTH_ALLOW_LOCAL_LOGIN=true

# 只有 UniAuthSync 使用 http:// 时设为 true；HTTPS 自签名证书请改 UNIAUTH_VERIFY_TLS。
UNIAUTH_ALLOW_INSECURE_HTTP=false
UNIAUTH_CACHE_STORE=redis

# UniAuthSync issuer，例如 https://oauth.example.com，必须与服务端配置完全一致。
UNIAUTH_ISSUER=

# UniAuthSync 中为 DooTask 创建的客户端凭据。OIDC 与 SCIM 可共用同一个客户端。
UNIAUTH_CLIENT_ID=
UNIAUTH_CLIENT_SECRET=

# 必须在 UniAuthSync 客户端回调地址白名单中登记，并保持完全一致。
UNIAUTH_REDIRECT_URI=https://dootask.example.com/api/uniauth/callback
UNIAUTH_SCOPES="openid profile email"

# 网络请求超时和缓存/临时票据有效期（秒），一般保持默认。
UNIAUTH_HTTP_TIMEOUT=30
UNIAUTH_JWKS_CACHE_SECONDS=3600
UNIAUTH_STATE_TTL_SECONDS=600
UNIAUTH_TICKET_TTL_SECONDS=60

# 公网保持 true；可信隔离内网使用自签名 HTTPS 证书时可设为 false。
UNIAUTH_VERIFY_TLS=true

# -----------------------------------------------------------------------------
# UniAuthSync SCIM 用户、组织和分组同步
# -----------------------------------------------------------------------------
# UniAuthSync 根地址，不要带 /scim/v2，例如 https://oauth.example.com。
SCIM_SERVER_URL=

# 通常留空并沿用 SCIM_SERVER_URL；仅当 SET issuer 与根地址不同时填写。
SCIM_ISSUER=

# 共用客户端时与上面的 UNIAUTH_CLIENT_ID / UNIAUTH_CLIENT_SECRET 相同。
SCIM_CLIENT_ID=
SCIM_CLIENT_SECRET=

# 公网保持 true；可信隔离内网使用自签名 HTTPS 证书时可设为 false。
SCIM_VERIFY_TLS=true

# 定时同步间隔和同步锁时长（秒），一般保持默认。
SCIM_POLL_INTERVAL=60
SCIM_LOCK_SECONDS=3600

# 填 UniAuthSync 客户端的 scim_event_secret。
# 同时将该客户端的 scim_event_uri 设为 https://dootask.example.com/api/scim/webhook。
SCIM_WEBHOOK_SECRET=

# 可留空。SCIM 新用户不会被强制修改本地密码，统一登录由 OIDC 完成。
SCIM_DEFAULT_PASSWORD_PREFIX=

# 同步部门；没有可映射部门时是否拒绝创建/更新用户。
SCIM_SYNC_DEPARTMENT=true
SCIM_REQUIRE_DEPARTMENT=true

# 顶层 Organization 对应根部门的负责人邮箱；必须是已同步、启用的 DooTask 管理员。
SCIM_ROOT_DEPARTMENT_OWNER_EMAIL=

# true：SCIM 直接 Group 成员关系权威替换用户部门；false：保留其他本地部门关系。
SCIM_REPLACE_DEPARTMENTS=false

# true：SCIM active=true 可恢复本地已离职用户；默认 false 避免覆盖本地停用决定。
SCIM_REACTIVATE_USERS=false

LARAVELS_LISTEN_IP=0.0.0.0
LARAVELS_LISTEN_PORT=20000
